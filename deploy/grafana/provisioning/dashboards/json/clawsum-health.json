      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"clawsum-health\", service=\"paperclip\"}",
          "legendFormat": "paperclip"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Hermes / Clawsum",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
