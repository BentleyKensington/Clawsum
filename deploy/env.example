# Clawsum instance overlay — copy to /docker/clawsum/.env and fill per VPS.
# Never commit .env. See deploy/docs/PLATFORM-DEPLOY-TEMPLATE.md

# --- Core ---
POSTGRES_USER=clawsum
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=clawsum

OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.6.10
PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:latest

OPENCLAW_GATEWAY_PORT=48166
OPENCLAW_GATEWAY_TOKEN=generate_with_openssl_rand_hex_32
OPENCLAW_TZ=America/Chicago
OPENCLAW_CONFIG_DIR=./data/.openclaw
OPENCLAW_AUTH_PROFILE_SECRET_DIR=./data/.openclaw-auth-secrets

TRAEFIK_HOST=srv.example.com
BOSS_UI_HOST=boss.srv.example.com
OPENCLAW_UI_HOST=clawsum.srv.example.com
GRAFANA_UI_HOST=grafana.srv.example.com

# --- Paperclip / Boss UI ---
BETTER_AUTH_SECRET=generate_with_openssl_rand_hex_32
PAPERCLIP_PUBLIC_URL=https://boss.srv.example.com
PAPERCLIP_AGENT_JWT_SECRET=generate_with_openssl_rand_hex_32
OPENCLAW_GATEWAY_URL=http://127.0.0.1:48166

# Ops portal Traefik basic auth (see setup-ops-portal-traefik.sh)
BOSS_OPS_AUTH_USER=boss
BOSS_OPS_AUTH_PASSWORD=
OPENCLAW_TRUSTED_PROXY=true
HERMES_UI_HOST=hermes.srv.example.com
HERMES_DASHBOARD_PORT=9119

# Hermes cockpit plugin data feeds (optional — see examples/hermes-cockpit/README.md)
# CLAWSUM_BOSS_URL=https://boss.srv.example.com
# CLAWSUM_OPENCLAW_URL=https://clawsum.srv.example.com
# CLAWSUM_GRAFANA_URL=https://grafana.srv.example.com
# CLAWSUM_GRAFANA_EMBED_URL=https://grafana.srv.example.com/d/clawsum-health?orgId=1&kiosk

# --- Paperclip instance IDs (generate per VPS — never commit real values) ---
PAPERCLIP_COMPANY_ID=

# --- Telegram (optional — set per instance) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_REPORT_CHAT_ID=
TELEGRAM_PAPERCLIP_GROUP_ID=
TELEGRAM_ADMIN_CHAT_ID=
# Gmail OAuth failure alerts use ADMIN then REPORT then openclaw admin group fallback
# GMAIL_OAUTH_ALERT_COOLDOWN_HOURS=6

# --- Discord (preferred mobile HQ — dual-write with Telegram until verified) ---
# Docs: deploy/docs/DISCORD-HQ.md
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_BOSS_USER_ID=
DISCORD_ALERT_CHANNEL_ID=
DISCORD_DIGEST_CHANNEL_ID=
DISCORD_BOSS_DESK_CHANNEL_ID=
DISCORD_JARVIS_CHANNEL_ID=
DISCORD_ADMIN_CHANNEL_ID=
NOTIFY_CHANNELS=discord,telegram

# --- GHL Telegram override (optional) ---
# GHL_TELEGRAM_GROUP_ID=

# --- LLM (optional — agents prefer Codex OAuth via Control UI) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- OpenRouter + speech (optional) — see env.openrouter-voice.example ---
# OPENROUTER_API_KEY=
# OPENROUTER_FREE_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_CHEAP_MID_MODEL=google/gemini-2.5-flash
# OPENROUTER_ESCALATION_MODEL=anthropic/claude-sonnet-4.6
# OPENROUTER_FRONTIER_MODEL=google/gemini-2.5-pro
# OPENROUTER_RESEARCH_MODEL=google/gemini-2.5-pro
# SPEECH_STT_PROVIDER=openai
SPEECH_TTS_PROVIDER=elevenlabs
# SPEECH_TTS_PROVIDER=openai

# CloseBot API key (OpenClaw/Hermes skill — not Paperclip skill-sync)
# Paperclip openclaw_gateway adapter does NOT sync skills; install via:
#   bash scripts/install-openclaw-skill.sh closebot-api-operator
# Header sent: X-CB-KEY
CLOSEBOT_API_KEY=
# X_CB_KEY=   # optional fallback name

# --- VAPI (voice agents) — https://dashboard.vapi.ai/org/api-keys ---
# VAPI_API_KEY=
# VAPI_BASE_URL=https://api.vapi.ai

# --- Printful / Shopify ---
# PRINTFUL_API_TOKEN=
# SHOPIFY_STORE=example.myshopify.com
# SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_API_VERSION=2026-07

# --- Deepgram / NVIDIA (LLM Lab + Vocalitic) ---
# DEEPGRAM_API_KEY=
# DEEPGRAM_STT_MODEL=flux-general-en
# NVIDIA_NIM_API_KEY=
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Product SSH (Vocalitic v1m12, AcceptAI) — values on VPS only ---
# VOCALITIC_CODEBASE_PATH=C:\APPS\V1m12
# VOCALITIC_SSH_HOST=69.62.64.214
# VOCALITIC_SSH_USER=root
# VOCALITIC_SSH_PORT=22
# VOCALITIC_SSH_KEY_PATH=
# VOCALITIC_DASHBOARD_URL=https://app1.vocalitic.com
# VOCALITIC_HEALTH_URL=
# ACCEPTAI_CODEBASE_PATH=C:\APPS\Projects\AcceptAI
# ACCEPTAI_SSH_HOST=
# ACCEPTAI_SSH_USER=
# ACCEPTAI_SSH_PORT=22
# ACCEPTAI_SSH_KEY_PATH=
# ACCEPTAI_API_BASE=
# ACCEPTAI_API_KEY=

# --- Ring official Appstore (Rocco) — never unofficial RE ---
# RING_CLIENT_ID=
# RING_CLIENT_SECRET=
# RING_REFRESH_TOKEN=

# --- Google Photos Picker (clawsums@gmail.com) ---
# GOOGLE_PHOTOS_ACCOUNT=clawsums@gmail.com


# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=change_me

# --- ArcadeDB ---
ARCADEDB_ROOT_PASSWORD=change_me

# --- MinIO (Tier 2 — storage profile) ---
MINIO_ROOT_USER=clawsum
MINIO_ROOT_PASSWORD=change_me

# --- Gmail pack (optional) — see env.gmail.example ---
# GOG / OAuth vars

# --- GHL pack (optional) — see env.ghl.example ---
# GHL_PIT=
# GHL_LOCATION_ID=
# GHL_DB_PASSWORD=
